<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>حزب بليتش الأعظم - اختبار الشخصية</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background-color: #222;
      color: white;
    }
    button {
      padding: 10px 20px;
      margin: 10px;
      background-color: #444;
      color: white;
      border: none;
      cursor: pointer;
      font-size: 18px;
    }
    button:hover {
      background-color: #555;
    }
    h2 {
      font-size: 24px;
    }
    #quiz-container {
      margin-top: 50px;
    }
  </style>
</head>
<body>
  <h1>مرحبًا في اختبار الشخصية - حزب بليتش الأعظم</h1>
  <div id="quiz-container">
    <!-- الزر سيظهر هنا قبل بدء الاختبار -->
    <button id="start-btn" onclick="startQuiz()">ابدأ الاختبار</button>
  </div>

  <script>
    const members = {
      "الحسن البهادلي": ["مدير قروب", "بهادلي", "زنجي", "قائد", "كوميدي", "محنك", "مثقف"],
      "الكعبي": ["لطيف", "متفهم", "عاطفي", "كعبي", "غني", "لعوب"],
      "حسن هادي": ["بهادلي", "زنجي", "شغوف", "لعوب", "صاحب طاقة عالية"],
      "عيسى": ["فرداني", "معارض", "كاره للقوانين", "لطيف", "متفهم", "مستقل", "مؤسس"],
      "محمد حسين": ["مدير قروب", "كوميدي", "متفهم", "مثقف", "محنك", "اجتماعي"],
      "توم": ["غبي", "كوميدي", "لعوب", "لا يمكن توقعه", "رومانسي"],
      "رضا": ["صاخب", "كوميدي", "صاحب طاقة عالية", "كاره للقوانين", "مثير للمشاكل", "باد بوي"],
      "احمد عباس": ["فرداني", "هادئ", "عقلاني", "زير نساء", "لعوب", "تنافسي"],
      "كرار عباس": ["برشلوني", "ذويق", "عاطفي", "تنافسي", "متفهم", "ودود"],
      "حيدر": ["كوميدي", "تنافسي", "برشلوني", "متفهم", "لامبالي", "رجولي"],
      "مصطفى": ["لعوب", "شغوف", "رومانسي", "مثقف", "متفهم", "عاطفي", "ذكي"],
      "جواد": ["فرداني", "كوميدي", "لعوب", "رومانسي", "متفهم", "مستقل"],
      "احمد خالد": ["متفهم", "هادئ", "كعبي", "لامبالي", "كوميدي", "ذكي"]
    };

    const questions = [
      { question: "هل تعتبر نفسك شخصًا عاطفيًا؟", trait: "عاطفي" },
      { question: "هل تحب أن تكون القائد في المواقف؟", trait: "قائد" },
      { question: "هل تفضل العمل بشكل فردي؟", trait: "فرداني" },
      { question: "هل أنت شخص مثقف؟", trait: "مثقف" },
      { question: "هل تحب المزاح وتتمتع بروح الدعابة؟", trait: "كوميدي" },
      { question: "هل تشعر أنك غامض ولا يمكن توقع تصرفاتك؟", trait: "لا يمكن توقعه" },
      { question: "هل تمتلك طاقة عالية وتحب الحركة؟", trait: "صاحب طاقة عالية" },
      { question: "هل تعتبر نفسك لعوبًا في العلاقات؟", trait: "لعوب" },
      { question: "هل أنت شخص متفهم للآخرين؟", trait: "متفهم" },
      { question: "هل تكره الالتزام بالقوانين الصارمة؟", trait: "كاره للقوانين" },
      { question: "هل تفضل التنافس على التعاون؟", trait: "تنافسي" },
      { question: "هل تحب أن تكون مركز الاهتمام؟", trait: "صاخب" },
      { question: "هل تشعر أنك رومانسي؟", trait: "رومانسي" },
      { question: "هل تتصرف أحيانًا بلا مبالاة؟", trait: "لامبالي" },
      { question: "هل تحب كرة القدم أو تتابع فريقًا؟", trait: "برشلوني" }
    ];

    let current = 0;
    let traits = [];

    function startQuiz() {
      document.getElementById("start-btn").style.display = "none"; // إخفاء زر البداية
      showQuestion(); // عرض السؤال الأول
    }

    function showQuestion() {
      const container = document.getElementById("quiz-container");
      container.innerHTML = `
        <h2>${questions[current].question}</h2>
        <div>
          <button onclick="answer(true)">نعم</button>
          <button onclick="answer(false)">لا</button>
        </div>
      `;
    }

    function answer(choice) {
      if (choice) traits.push(questions[current].trait);
      current++;
      if (current < questions.length) {
        showQuestion();
      } else {
        showResult();
      }
    }

    function showResult() {
      let scores = {};
      for (let name in members) {
        scores[name] = members[name].filter(trait => traits.includes(trait)).length;
      }
      const bestMatch = Object.keys(scores).reduce((a, b) => scores[a] > scores[b] ? a : b);
      const container = document.getElementById("quiz-container");
      container.innerHTML = `<h2>أنت تطابق: ${bestMatch}</h2>`;
    }
  </script>
</body>
</html>
