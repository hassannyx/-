body {
  background-color: black;
  color: white;
  font-family: 'Arial', sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
  padding: 0;
}

#app {
  max-width: 600px;
  text-align: center;
  padding: 20px;
}

button {
  padding: 15px 30px;
  margin-top: 20px;
  font-size: 18px;
  cursor: pointer;
  border: none;
  background-color: #444;
  color: white;
  border-radius: 10px;
  transition: background-color 0.3s, transform 0.3s;
}

button:active {
  transform: scale(0.95); /* تأثير ضغط الزر */
  background-color: #666;
}

h2 {
  font-size: 24px;
  margin-bottom: 20px;
}
